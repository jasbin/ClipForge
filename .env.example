# LLM provider: "ollama" (local, free, no key) or "anthropic" (Claude API).
CLIPFORGE_LLM_PROVIDER=ollama
# CLIPFORGE_LLM_MODEL=gpt-oss:20b          # ollama default; anthropic default: claude-sonnet-5-5
# CLIPFORGE_LLM_EFFORT=low                 # low | medium | high (ollama default low, anthropic medium)
# CLIPFORGE_OLLAMA_NUM_CTX=16384
# OLLAMA_HOST=http://localhost:11434

# Only needed when CLIPFORGE_LLM_PROVIDER=anthropic (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=

# Optional overrides
# CLIPFORGE_DATA_DIR=./data
# CLIPFORGE_WHISPER_MLX_MODEL=mlx-community/whisper-large-v3-turbo
